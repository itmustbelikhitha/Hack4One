# ============================================================
# Dayflow HRMS — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit the real .env file to git.
# ============================================================

# ---- Database (Supabase) ----
# The shared Postgres database URL. Used by the backend.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase project URL and keys. Used by both frontend and backend.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Frontend (Vite) ----
# Vite requires the VITE_ prefix to expose vars to the browser.
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_BASE_URL=http://localhost:3001/api

# ---- Backend ----
# The port the Express API server runs on.
PORT=3001
# Secret key for signing JWT tokens (if using custom auth).
SECRET_KEY=your-secret-key-change-this
# The base URL the frontend uses to reach this API.
API_BASE_URL=http://localhost:3001/api
